<svg viewBox="0 0 640 480" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="640" height="480" fill="#0F172A"/>
  <circle cx="320" cy="240" r="150" fill="none" stroke="#3B82F6" stroke-width="2" stroke-dasharray="20,10"/>
  <circle cx="320" cy="240" r="100" fill="none" stroke="#10B981" stroke-width="2" stroke-dasharray="15,15"/>
  <circle cx="320" cy="240" r="50" fill="url(#gradMG)"/>
  <text x="320" cy="240" text-anchor="middle" dominant-baseline="middle" font-family="Inter, system-ui" font-size="24" fill="white" font-weight="700">MOTION</text>
  <text x="320" y="420" text-anchor="middle" font-family="Inter, system-ui" font-size="20" fill="white" font-weight="600">Motion Graphics & Animation</text>
  <defs>
    <linearGradient id="gradMG" x1="0" y1="0" x2="640" y2="480" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#1152DF"/>
      <stop offset="100%" stop-color="#3B82F6"/>
    </linearGradient>
  </defs>
</svg>